{% set media = node.field_news_media.entity %}

{% set news_title = node.field_news_title.value|striptags %}
{% set news_date = node.field_news_date.value|date('d F Y') %}
{% set news_body = node.field_news_body.0.processed|default('') %}
{% set news_updated = node.changed.value|date('j/n/Y') %}

{% if media and media.field_media_image.entity %}
  {% set image = media.field_media_image.entity.uri.value %}

  {% include 'misk_theme:news-article' with {
    title: news_title,
    date: news_date,
    image: image,
    body: news_body,
    updated: news_updated
  } only %}
{% else %}
  {% include 'misk_theme:news-article' with {
    title: news_title,
    date: news_date,
    body: news_body,
    updated: news_updated
  } only %}
{% endif %}