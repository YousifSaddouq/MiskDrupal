<article class="news-card px-4">

  {% if image %}
    <a href="{{ url }}">
      <div class="news-card-media position-relative overflow-hidden rounded-3">

        <img
          src="{{ file_url(image) }}"
          alt="{{ title }}"
          class="w-100 object-fit-cover"
        >

        {% if date %}
          <div class="news-date position-absolute bg-primary text-white py-2 px-6 rounded-pill">
            <span>{{ date }}</span>
          </div>
        {% endif %}

      </div>
    </a>
  {% endif %}


  <div class="news-card-content pt-9 pb-3">

    {% if not image and date %}
      <div class="news-date bg-primary text-white d-inline-block py-2 px-6 rounded-pill mb-3">
        {{ date }}
      </div>
    {% endif %}

    <h3 class="news-title mb-3">
      {{ title|raw }}
    </h3>

    <div class="pb-11">
      <div class="news-link d-inline-flex link-more">

        <a href="{{ url }}" class="fw-bold">
          Read More
        </a>

        <i class="bi bi-caret-right-fill"></i>

      </div>
    </div>

  </div>

</article>