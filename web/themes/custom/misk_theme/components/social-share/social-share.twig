<div
  class="social-share a2a_kit a2a_default_style"
  {% if url %}
    data-a2a-url="{{ url }}"
  {% endif %}
  {% if title %}
    data-a2a-title="{{ title }}"
  {% endif %}
>

  <a class="a2a_button_facebook social-share__button"
     aria-label="Share on Facebook">
    <i class="bi bi-facebook"></i>
  </a>

  <span class="social-share__button social-share__instagram"
        aria-label="Instagram">
    <i class="bi bi-instagram"></i>
  </span>

  <a class="a2a_button_linkedin social-share__button"
     aria-label="Share on LinkedIn">
    <i class="bi bi-linkedin"></i>
  </a>

  <a class="a2a_button_x social-share__button"
     aria-label="Share on X">
    <i class="bi bi-twitter-x"></i>
  </a>

</div>