<div class="partner-cell d-flex justify-content-center align-items-center w-100">
  <a
    href="{{ url|default('#') }}"
    class="d-flex justify-content-center align-items-center w-100 h-100"
    target="_blank"
    rel="noopener"
    aria-label="{{ title|default('Partner') }}"
  >

    {% if image %}
      <img
        class="img-fluid"
        src="{{ file_url(image) }}"
        alt="{{ title|default('') }}"
      >
    {% endif %}

  </a>




</div>